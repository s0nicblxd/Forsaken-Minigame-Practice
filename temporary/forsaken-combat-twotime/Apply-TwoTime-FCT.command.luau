				Count = 0,
				Flowers = {}
			};
			u412.State.FlowersGenerated[p413] = v426;
		end;

		if p414 ~= v426.Count then
			if p414 < v426.Count then
				for _ = #v426.Flowers, p414 + 1, -1 do
					deleteOneFlower(p413);
				end;
			elseif v426.Count < p414 then
				for _ = 1, p414 - v426.Count do
