				end

				v80 = true
			end
		end

		if not v80 then
			return p14:GetBoundingBox()
		end

		local vector3 = Vector3.new((n3 + n6) / 2, (n4 + n7) / 2, (n5 + n8) / 2)
		local vector3_2 = Vector3.new(n6 - n3, n7 - n4, n8 - n5)

		return CFrame.new(vector3), vector3_2
	end
}

