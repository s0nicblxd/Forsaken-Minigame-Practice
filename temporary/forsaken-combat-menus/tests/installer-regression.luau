 for _,item in data do
  local parts=string.split(item.path,'/');local parent=base
  for i=1,#parts-1 do parent=parent:FindFirstChild(parts[i])or child(parent,parts[i])end
  local object=parent:FindFirstChild(parts[#parts])or child(parent,parts[#parts],item.class)
  object.ClassName=item.class
  if item.source then object.Source=item.source end
  created[item.path]=object
 end
 return created
end
