				table.insert(t4, {
					place_id = v14.PlaceId,
					game_id = v14.GameId
				})
			end
		end

		local v15 = #t4 > 0 and t4[math.random(#t4)] or nil

		if v15 == nil then
			NotificationDisplay:DisplayNotification("There are no friends online to join!", Color3.fromRGB(203, 53, 53))
			warn("[QuickPlay.MouseDown | LOG]: There are no friends to select!")

			return
		end

		Network:FireServerConnection("RequestTeleportAsync", "REMOTE_EVENT", v15.place_id, v15.game_id)

		return
	end

	Network:FireServerConnection("RequestTeleportAsync", "REMOTE_EVENT", t3.place_id)
end

return t1

