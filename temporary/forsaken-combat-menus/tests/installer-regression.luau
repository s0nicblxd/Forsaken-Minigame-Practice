	-- upvalues: Players (copy), t1 (copy), NotificationDisplay (copy), Network (copy)
	if t3.place_id == nil then
		warn("[QuickPlay.MouseDown | LOG]: Cannot initiate teleport as 'place_id' is malformed.")

		return
	end

	local t4 = {}

	if t3.place_id < 1 then
		for _, v14 in (Players.LocalPlayer:GetFriendsOnlineAsync()) do
			if t1.__allIDsAvailable[v14.PlaceId] ~= nil then
